// TeamFlow Build-Konfiguration — TEMPLATE
//
// Dies ist die Referenz-Config mit allen verfügbaren Optionen
// und Erläuterungen. Nicht direkt zum Bauen verwenden — stattdessen
// eine der *.config.json als Kopie anpassen.
//
// Build-Aufruf: npm run build:variant -- --config configs/meine.config.json
// Config-UI:    npm run config-ui

{
  "configVersion": 2,
  "variant": "custom", // "development" | "production" | "custom"

  "build": {
    // Anzeige-Label in Sidebar und Header
    "label": "TeamFlow",
    // Dateiname des Builds, ohne .html — wird zu teamflow.html
    "outputFilename": "teamflow",
    // Browser-Tab-Titel
    "browserTabTitle": "TeamFlow",
    // Untertitel unter dem Label im Sidebar-Header. Optional — Fallback "Verwaltung".
    "sidebarSubtitle": "Verwaltung"
  },

  "data": {
    // Fester Pfad zum Daten-Share. Wenn gesetzt, sieht der User ihn im Welcome-Screen.
    // Beispiel Windows-SMB: "\\\\server\\teamflow-forschungsfoerderung\\"
    //
    // v2.0.2: Default kommt aus configs/_shared.json — dort wird der org-weite
    // Pfad zentral gepflegt. Hier nur eintragen wenn diese Variante einen
    // ANDEREN Pfad braucht (z.B. eine Variante, die explizit `null` setzt, um
    // den shared-Default zu deaktivieren).
    "fixedDataSharePath": null,
    // v2.0: erwarteter Ordner-Name beim Daten-Share-Picker.
    // Default ebenfalls aus configs/_shared.json — hier nur Override eintragen
    // wenn die Variante einen anderen Ordner-Namen erwartet.
    "expectedFolderName": null,
    // User darf den Pfad im Welcome-Screen selbst auswählen
    "allowUserToChangePath": true,
    // Lokaler tmp-Ordner erlaubt, falls kein SMB verfügbar (nur DEV sinnvoll)
    "allowLocalFallback": false,
    // Förder-Fixture-CSVs beim ersten Start automatisch laden (nur DEV-Build)
    "demoDataBundled": false
  },

  // v2.0: Persönlicher Ordner auf dem User-Home-Laufwerk.
  // Trägt profile.json, einstellungen.json und die Feedback-Outbox.
  // Optional — wenn weggelassen, gelten die hier gezeigten Defaults.
  "personalFolder": {
    "subfolder": "ZAH",
    "required": false,
    "promptAfterProfile": true,
    "snapshotAgeWarningDays": 3
  },

  "features": {
    "kuratorMenus": true,      // Kurator-Sidebar-Kategorie + Kuration-Plugins
    // v2.10: Login-Wall beim App-Start. Erzwingt Kurator-Passwort, schaltet
    // danach is_kurator (Menüs) + Schreib-Session frei. Nur kurator-Variante
    // true; dev hat zwar kuratorMenus, aber keine Wall (Auto-Kurator).
    "requireKuratorLogin": false,
    "feedback": true,          // Feedback-FAB + Board + Kurator-Verwaltung
    "dokumentenscan": false,   // ab Phase 2, noch nicht implementiert
    "volltextsuche": true,     // Such-Route + Index-Kuration
    "devInfraPanel": true,     // Dev-Infra-Test-Plugin sichtbar
    // ACHTUNG: Nur in variant=development erlaubt. Schema-Validierung bricht
    // den Build ab, wenn devFixtures=true + variant=production.
    // Fixtures enthalten destruktive Operationen (resetAll) + sensible Defaults.
    "devFixtures": false,

    // Bereichs-Menüs:
    //
    // - antraege: Das zentrale (und einzige) Bereichs-Menü — Förderanträge.
    //   Enthält seit v1.14 auch die konsolidierten Forschungsvorgänge (das
    //   separate `forschung`-Plugin wurde entfernt, Fixtures sind in den
    //   Antrags-Seed migriert).
    //
    // - dokumente: Platzhalter für Phase 2 (Dokumentenscan). Default deaktiviert.
    //
    // Validation: features.antraege muss true sein, sonst bricht der Build ab.
    "antraege": true,
    "dokumente": false,
    // Auslastung-Modul: automatische Kategorisierung + MA-Zuweisung. Default
    // false; in dev.config aktivieren um das Plugin auszuprobieren.
    "auslastung": false,

    // Schreibrecht auf den Daten-Share auch ohne Kurator-Profil. Hebt das
    // v2.0-read-only-Hardening gezielt fuer Rollen auf, die aktiv in `_intern/*`
    // schreiben (PL: Auslastungs-Klassifizierung → auslastung.json). Steuert
    // Picker-/Grant-Mode (read vs readwrite). Nur dev + pl true.
    "datenShareSchreibrecht": false,

    // User-Plugin-Gates (Sidebar-Sichtbarkeit). Getrennt von den Master-Flags
    // volltextsuche/feedback, damit z.B. die kurator-Variante den Suchindex-
    // Kurator und die Feedback-Kuration freischalten kann, ohne dass das
    // User-Suche-Plugin / Feedback-Board in der normalen Sidebar erscheint.
    "chat": true,           // AI-Chat-Plugin (Sidebar-Eintrag "Chat")
    "suche": true,          // User-Hybrid-Suche-Plugin (Sidebar-Eintrag "Suche")
    "feedbackBoard": true,  // Öffentliches Feedback-Board (Sidebar-Eintrag)
    "feedbackDelete": false, // Dev-only: Löschen von Feedback-Tickets im Kurator-Dashboard (nach Bestätigung); optional, fehlt = aus
    // Hinweis: pl/kurator lassen diesen optionalen Flag weg (= aus) — nur dev setzt true.
    // v2.18: CSV-Auto-Refresh-Banner + „CSV-Quelle verknüpfen"-Picker auch ohne
    // Kurator-Menüs. Der Kurator-Banner läuft unabhängig über kuratorMenus —
    // dieser Flag schaltet ihn zusätzlich in Nicht-Kurator-Builds frei (pl).
    // Braucht datenShareSchreibrecht zum Schreiben des Snapshots. Nur dev + pl.
    "csvAutoRefresh": false,
    // Gutachten-Testballon: KI-gestützte Kurzfassung-Sektion auf der Förder-
    // antrags-Detailseite (Dokumenten-Aufnahme → Skill → Review/Freigabe →
    // DOCX-Vorlage). Erster „Mini-Agent". Optional, fehlt = aus. Nur dev (Testballon).
    "gutachtenKurzfassung": false,
    // Gutachten-Workflow A–G: deterministischer Workflow-Runner über Registry-Skills
    // (löst die Kurzfassung-Sektion ab). Optional, fehlt = aus. Nur dev.
    "gutachtenWorkflow": false,
    // NF-Nachforderungen (Artefakt-Engine): Pro-TV-NF-Entwürfe auf der Verbund-
    // Detailseite (Baustein-Auswahl/-Füllung → QS → DOCX + E-Mail-Entwurf).
    // Optional, fehlt = aus. Nur dev (Testballon).
    "nfNachforderungen": false,
    // Modul „Anfragen": E-Mail-Kurzanfrage (.msg) → interne KI-Anonymisierung →
    // Export ins externe ZIM-Dashboard (Zwischenablage) → deterministische
    // Wiedereinsetzung → mail-fertige Antwort. Plugin-Flag. Optional, fehlt = aus.
    // Nur dev (Testballon).
    "anfragen": false,
    // In-App „Streamlit Bridge"-Installer im KI-Assistent-Tab: Streamlit-URL
    // konfigurieren, Bookmarklet in die Lesezeichenleiste ziehen, Verbindung
    // (tf-ping → tf-pong) testen. Zugang zum internen gpt-oss ohne API.
    // Endkunden-tauglich. Optional, fehlt = aus. Sichtbar dev + prod + kurator + pl.
    "streamlitBridge": false,
    // v2.97: Delta-Snapshots SCHREIBEN — nur geänderte antraege-Records
    // publizieren (antraege.delta.<seq>.jsonl) statt der vollen Datei. Spart dem
    // Writer den ~25-s-Voll-Write + jedem Konsumenten den Voll-Download. Braucht
    // datenShareSchreibrecht; nur pl + kurator (+ dev). Der LESER versteht Deltas
    // immer (kein Flag). Optional, fehlt = aus (voller v1-Write). ERST aktivieren,
    // wenn der Delta-Leser flächig ausgerollt ist (2-Phasen-Rollout).
    "deltaSnapshotWrite": false
  },

  // Pro Variant überschreibbare Sidebar-Labels für Bereichs-Menüs.
  // Fehlende Keys fallen auf die Default-Labels ("Förderanträge", "Dokumente")
  // zurück. `antraege` kann z.B. auf "Anträge" gesetzt werden, wenn der Begriff
  // "Förderanträge" zu fachspezifisch ist.
  "menuLabels": {
    "antraege": "Förderanträge",
    "dokumente": "Dokumente"
  },

  // Optional. Nur relevant wenn features.devFixtures=true.
  // Wird in production ignoriert.
  "dev": {
    "defaultKuratorName": "Dev",
    "defaultKuratorPassword": "dev",
    "dataSharePath": null,
    // Kurator-Session bleibt 30 Tage aktiv statt der Default-12h — kein
    // Passwort-Reentry zwischen App-Restarts nötig.
    "sessionTtlDays": 30,
    // Beim ersten Klick nach App-Start: Permission auf SMB-Handle refreshen,
    // falls Handle existiert aber Permission auf 'prompt' steht.
    "autoRefreshSmbPermission": true,
    // Nach destruktiven Fixture-Aktionen (Szenario anwenden, CSV leeren,
    // Kurator-Flag togglen): kurzer Toast + Full-Page-Reload, damit Zustand
    // sauber aus der neuen IndexedDB-Situation aufgebaut wird. Für manuelle
    // Debug-Sessions auf false setzen.
    "autoReloadAfterScenario": true
  },

  "ki": {
    "localLlama": {
      "enabled": true,
      "endpoint": "http://localhost:8081"
    },
    "openrouter": {
      // ACHTUNG: Bei variant=production + fester Daten-Pfad verboten
      // (würde echte Daten an Cloud-API senden) — Build bricht ab.
      "enabled": false,
      "allowedModels": [
        // "openai/gpt-oss-120b"
      ]
    }
  },

  "branding": {
    "logoUrl": null,
    "primaryColor": null
  },

  // Phase-2 Dokumentenscan-Konfiguration. Wirkt nur, wenn features.dokumentenscan = true.
  // Ist features.dokumentenscan = true, ist scan.file_extensions Pflicht (sonst Build-Abbruch).
  "scan": {
    // Relative Unterprogramm-Roots im dokumentenquelle-Handle.
    // Leer = der gesamte Handle ist ein einziger Root.
    "sub_roots": [],
    // Erlaubte Datei-Endungen, lowercase mit Punkt.
    "file_extensions": [".pdf", ".docx"],
    // Maximale Rekursionstiefe für den Walker (Schutz vor Symlink-Loops).
    "max_depth": 20,
    // Erlaubte FKZ-Präfixe — Format: 2 Ziffern + 2 Großbuchstaben.
    // Wird zur Build-Time strukturell geprüft. Die Inhalts-Prüfung (alle FKZs
    // in der Antrags-CSV müssen erlaubtes Präfix haben) findet beim CSV-Import statt.
    "fkz_allowed_prefixes": ["16EP", "16KN", "16DS", "16DL"]
  }

  // v2.16: Build-Time Rollen-Passwort-Gate (optional). Wenn gesetzt + required=true,
  // erzwingt der Build beim App-Start eine Vollbild-Passwort-Wall (AppPasswordGate) —
  // ohne korrektes Passwort ist die App nicht nutzbar. Genutzt fuer pl + kurator.
  //
  // NICHT von Hand eintragen! salt + verifier werden generiert via:
  //   npm run set-password -- <pl|kurator> "Mein-Passwort"
  // Das schreibt nur den gesalzenen Verifier in die Config — niemals das Klartext-
  // Passwort. In der kurator-Variante fuehrt ein erfolgreicher Login zusaetzlich die
  // Kurator-Eskalation aus (is_kurator + Schreib-Session + readwrite-Handle).
  //
  // Sicherheits-Einordnung: Casual-Access-Gate (verhindert versehentliches Oeffnen
  // durch normale MAs). Der Verifier ist offline brute-forcebar — akzeptiert unter
  // dem Single-Team-Trust-Modell. Starkes Passwort waehlen.
  //
  // "auth": {
  //   "required": true,
  //   "hint": "Bei Fragen zum Zugang: Projektleitung.",  // optional, unter dem Feld
  //   "salt": "<base64 — generiert>",
  //   "verifier": "<base64 — generiert>"
  // }
}
