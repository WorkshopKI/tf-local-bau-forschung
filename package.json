{
  "name": "teamflow-local",
  "private": true,
  "version": "2.363.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:test-csvs": "node scripts/generate-test-csvs.mjs",
    "generate:test-label-xlsx": "node scripts/generate-test-label-xlsx.mjs",
    "normalize:fixture-csvs": "node scripts/normalize-fixture-csvs.mjs",
    "build:default-labels": "node scripts/build-default-labels.mjs",
    "set-password": "node scripts/set-app-password.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "generate:eval-fixtures": "npx tsx src/core/services/eval-fixtures/cli.ts",
    "generate:ort-wasm": "node scripts/generate-ort-wasm-module.mjs",
    "generate:test-assets": "npm run generate:test-csvs && npm run generate:test-label-xlsx && npm run normalize:fixture-csvs && npm run build:default-labels && npm run generate:ort-wasm",
    "predev": "npm run normalize:fixture-csvs && npm run generate:ort-wasm",
    "prebuild": "npm run generate:test-assets",
    "prebuild:variant": "npm run generate:test-assets",
    "prebuild:dev": "npm run generate:test-assets",
    "prebuild:prod": "npm run generate:test-assets",
    "prebuild:kurator": "npm run generate:test-assets",
    "prebuild:pl": "npm run generate:test-assets",
    "prebuild:as": "npm run generate:test-assets",
    "build": "tsc -b && vite build",
    "build:variant": "node scripts/build-with-config.mjs",
    "build:dev": "node scripts/build-with-config.mjs --config configs/dev.config.json",
    "build:prod": "node scripts/build-with-config.mjs --config configs/prod.config.json",
    "build:kurator": "node scripts/build-with-config.mjs --config configs/kurator.config.json",
    "build:pl": "node scripts/build-with-config.mjs --config configs/pl.config.json",
    "build:as": "node scripts/build-with-config.mjs --config configs/as.config.json",
    "prebuild:all": "npm run generate:test-assets",
    "build:all": "node scripts/build-with-config.mjs --config configs/dev.config.json && node scripts/build-with-config.mjs --config configs/prod.config.json && node scripts/build-with-config.mjs --config configs/kurator.config.json && node scripts/build-with-config.mjs --config configs/pl.config.json && node scripts/build-with-config.mjs --config configs/as.config.json",
    "prebuild:devprod": "npm run generate:test-assets",
    "build:devprod": "node scripts/build-with-config.mjs --config configs/dev.config.json && node scripts/build-with-config.mjs --config configs/prod.config.json",
    "config-ui": "node scripts/serve-config-ui.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --build",
    "typecheck:full": "tsc --build --force",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:phase2": "vitest run src/phase2",
    "eval:skills": "vite-node --config vitest.config.mts src/core/services/skill-eval/cli.ts --",
    "eval:aufbereitung": "vite-node --config vitest.config.mts src/core/services/skill-eval/aufbereitung-eval.ts --",
    "eval:gedaechtnis": "vite-node --config vitest.config.mts src/core/services/skill-eval/gedaechtnis-eval.ts --",
    "map": "node scripts/generate-code-map.mjs",
    "gen:status-codes": "node scripts/gen-status-codes.mjs",
    "cycles": "node scripts/check-cycles.mjs",
    "precheck": "npm run map",
    "check:quick": "npm run typecheck && npm run lint && npm run test:changed",
    "check": "npm run typecheck && npm run lint && npm run cycles && npm run test && npm run build:dev"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.40.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@huggingface/transformers": "^4.0.1",
    "@orama/orama": "^3.1.18",
    "@uiw/react-codemirror": "^4.25.9",
    "cfb": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.5",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.5.207",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.3",
    "vite-node": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.5"
  }
}
